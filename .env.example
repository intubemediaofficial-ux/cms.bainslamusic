# ─────────────────────────────────────────────────────────────
# Bainsla Music CMS — environment configuration
# Copy to .env.local and fill in per-instance values.
# Each independent instance MUST use its own domain, Redis, and
# Google OAuth client so data stays isolated from other instances.
# ─────────────────────────────────────────────────────────────

# Public origin of THIS instance (drives OAuth redirects, login/email links).
# e.g. https://cms.bainslamusic.com
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=
# Random secret for NextAuth session signing: openssl rand -base64 32
NEXTAUTH_SECRET=

# Isolated data store for THIS instance (do NOT reuse another instance's Redis).
# e.g. redis://USER:PASS@HOST:6379
REDIS_URL=

# Google Cloud OAuth client for THIS instance's project/domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YouTube Data/Analytics API key (project 185376890124 for the new instance).
GOOGLE_API_KEY=
YOUTUBE_API_KEY=

# Admin login passwords (no source fallback — must be set here).
# ADMIN_PASSWORD_2 = ajeetgurjarofficial@gmail.com
# ADMIN_PASSWORD_3 = bainslamusicofficial@gmail.com
# ADMIN_PASSWORD_4 = shivlalbainslaofficial@gmail.com
ADMIN_PASSWORD_2=
ADMIN_PASSWORD_3=
ADMIN_PASSWORD_4=

# AES-256-GCM key used to encrypt stored channel OAuth tokens.
CHANNEL_TOKEN_ENCRYPTION_KEY=

# Shared secret guarding the scheduled sync endpoints (cron).
CRON_SECRET=

# Email delivery — use Resend OR SMTP (Resend takes precedence if both set indirectly).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=

# Google Sheets export (vendor sheet sync).
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
VENDOR_GOOGLE_SHEET_ID=

# Revenue export API key (external revenue import authorization).
REVENUE_EXPORT_API_KEY=

# Optional backend integration (leave blank for a standalone instance).
BACKEND_URL=
NEXT_PUBLIC_BACKEND_URL=
# Endpoint the app posts client-channel updates to (isolate per instance).
CLIENT_CHANNELS_SYNC_URL=
